      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A website you allow in the current Profile can use the microphone. Safira never uses it for itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un site web que vous autorisez dans le profil actuel peut utiliser le micro. Safira ne l’utilise jamais pour lui-même."
          }
