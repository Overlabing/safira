            "state": "translated",
            "value": "A website you allow in the current Profile can read your location. Safira never uses it for itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un site web que vous autorisez dans le profil actuel peut connaître votre position. Safira ne l’utilise jamais pour lui-même."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "System permission prompt, from Info.plist",
