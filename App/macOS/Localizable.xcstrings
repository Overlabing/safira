    "A camera, microphone or location a page is already using keeps running until the page stops it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A camera, microphone or location a page is already using keeps running until the page stops it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une caméra, un micro ou une localisation qu’une page utilise déjà continue de fonctionner jusqu’à ce que la page l’arrête."
          }
        }
      }
    },
    "A command %@ has no equivalent for keeps Safira's key, marked “Inherited from Safira”. Choosing another preset clears your changes." : {
      "comment" : "Shortcuts window footnote; the argument is a browser's name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A command %@ has no equivalent for keeps Safira's key, marked “Inherited from Safira”. Choosing another preset clears your changes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une commande sans équivalent dans %@ garde la touche de Safira, signalée « Hérité de Safira ». Choisir un autre préréglage efface vos modifications."
          }
        }
      }
    },
    "A page wants to open a “%@:” link." : {
      "comment" : "Permission sheet of a site or a link to another app",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A page wants to open a “%@:” link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une page veut ouvrir un lien « %@: »."
          }
        }
      }
    },
    "A site or a link asks each time until you choose to remember your choice. Revoking a choice makes it ask again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A site or a link asks each time until you choose to remember your choice. Revoking a choice makes it ask again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un site ou un lien demande à chaque fois, jusqu’à ce que vous choisissiez de mémoriser votre choix. Révoquer un choix le fait demander de nouveau."
          }
        }
      }
    },
