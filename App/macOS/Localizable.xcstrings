{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ could not open the link." : {
      "comment" : "Permission sheet of a site or a link to another app",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not open the link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu ouvrir le lien."
          }
        }
      }
    },
    "%@ edits text in a field, so the menu cannot use it." : {
      "comment" : "Shortcuts window: a key such as ⌃⌘← that is never a menu key",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ edits text in a field, so the menu cannot use it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ modifie le texte d’un champ : le menu ne peut pas l’utiliser."
          }
        }
      }
    },
    "%@ is also on “%@”." : {
      "comment" : "Shortcuts window: two commands share a key; a key, then a command name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is also on “%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est aussi sur « %2$@ »."
          }
        }
      }
    },
