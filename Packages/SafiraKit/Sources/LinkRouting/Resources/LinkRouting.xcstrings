    "These links skip the Link rules and the Link picker. A Slack link also needs the Slack folder granted in the Safira menu; without it the link goes to the rules or the Link picker. Each app can be turned off in the rules file." : {
      "comment" : "Defaults: explanation of opening links in native apps",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These links skip the Link rules and the Link picker. A Slack link also needs the Slack folder granted in the Safira menu; without it the link goes to the rules or the Link picker. Each app can be turned off in the rules file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces liens échappent aux règles de lien et au sélecteur de liens. Un lien Slack demande aussi l’accès au dossier de Slack, accordé dans le menu Safira ; sans lui, le lien passe par les règles ou le sélecteur de liens. Chaque app peut être désactivée dans le fichier des règles."
          }
        }
      }
    },
    "Type or paste a link first." : {
      "comment" : "Link rules window: result of the link check with an empty field",
      "localizations" : {
        "en" : {
          "stringUnit" : {
