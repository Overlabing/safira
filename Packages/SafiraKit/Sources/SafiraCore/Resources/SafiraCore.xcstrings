          }
        }
      }
    },
    "View menu, or Safira menu, Defaults…" : {
      "comment" : "Defaults: where to change Sidebar on the Right",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View menu, or Safira menu, Defaults…"
          }
        },
