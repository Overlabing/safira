    },
    "Downloaded files go to your Downloads folder, and each Profile keeps its own list of them, which the Show Downloads command opens." : {
      "comment" : "Defaults: explanation of Downloads folder",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded files go to your Downloads folder, and each Profile keeps its own list of them, which the Show Downloads command opens."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers téléchargés vont dans votre dossier Téléchargements, et chaque profil en garde sa propre liste, qu’ouvre la commande Téléchargements."
          }
        }
      }
    },
    "Downloads folder" : {
      "comment" : "Defaults: entry title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads folder"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier des téléchargements"
          }
        }
      }
    },
    "Each Profile has its own search engine, and none is chosen for you. A Profile cannot be created without one; if you skip it, the Command bar asks at the first search." : {
      "comment" : "Defaults: explanation of Search engine",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each Profile has its own search engine, and none is chosen for you. A Profile cannot be created without one; if you skip it, the Command bar asks at the first search."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque profil a son propre moteur de recherche, et aucun n’est choisi pour vous. Un profil ne peut pas être créé sans moteur ; si vous passez cette étape, la barre de commande le demande à la première recherche."
          }
        }
      }
    },
    "HTTPS first" : {
