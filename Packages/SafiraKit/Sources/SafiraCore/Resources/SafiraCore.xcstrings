            "value" : "Suggestions de recherche distantes"
          }
        }
      }
    },
    "Restore Tabs lazily" : {
      "comment" : "Defaults: entry title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore Tabs lazily"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurer les onglets à la demande"
          }
        }
      }
    },
    "Safari's Develop menu" : {
      "comment" : "Defaults: where to change Web inspector",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari's Develop menu"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "menu Développement de Safari"
          }
        }
      }
    },
    "Safira collects no usage data and has no analytics. Nothing is sent without an action of yours: a page you open, a search you submit, an update check you ask for, a log you export." : {
      "comment" : "Defaults: explanation of Telemetry",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safira collects no usage data and has no analytics. Nothing is sent without an action of yours: a page you open, a search you submit, an update check you ask for, a log you export."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safira ne collecte aucune donnée d’utilisation et n’a aucune mesure d’audience. Rien n’est envoyé sans une action de votre part : une page que vous ouvrez, une recherche que vous lancez, une vérification des mises à jour que vous demandez, un journal que vous exportez."
          }
        }
      }
    },
    "Safira does not contact its update server until you choose Check for Updates, or turn this on. Turned on, it checks in the background." : {
      "comment" : "Defaults: explanation of automatic update checks",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safira does not contact its update server until you choose Check for Updates, or turn this on. Turned on, it checks in the background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safira ne contacte pas son serveur de mises à jour tant que vous ne choisissez pas Rechercher les mises à jour, ou que vous n’activez pas ce réglage. Activé, il vérifie en arrière-plan."
          }
        }
      }
    },
    "Safira menu" : {
      "comment" : "Defaults: where to change a default, the app menu",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safira menu"
          }
        },
        "fr" : {
