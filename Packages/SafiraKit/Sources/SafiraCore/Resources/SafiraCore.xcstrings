    },
    "Pages can be inspected from the Develop menu of Safari, once Safari's Develop menu is enabled. Safira has no inspector of its own." : {
      "comment" : "Defaults: explanation of Web inspector",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pages can be inspected from the Develop menu of Safari, once Safari's Develop menu is enabled. Safira has no inspector of its own."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages peuvent être inspectées depuis le menu Développement de Safari, une fois ce menu activé dans Safari. Safira n’a pas d’inspecteur à lui."
          }
        }
      }
    },
    "Profiles menu, Site Permissions…" : {
      "comment" : "Defaults: where to change it; a menu and its item",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
