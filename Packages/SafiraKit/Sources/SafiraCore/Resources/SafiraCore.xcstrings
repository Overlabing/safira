            "state" : "translated",
            "value" : "Barre latérale à droite"
          }
        }
      }
    },
    "Telemetry" : {
      "comment" : "Defaults: entry title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telemetry"
          }
        },
        "fr" : {
